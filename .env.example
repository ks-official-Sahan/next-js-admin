# Copy to .env.local and fill in. .env.local is git-ignored (.env*.local).
# This file lists names only. Never put a real value here.
#
# The public site builds and runs with none of these set. The admin panel needs
# DATABASE_URL plus the secrets marked (admin).

# --- Owner account (seed). The password is temporary: change it on /admin/account. ---
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# --- Auth and signing (admin) ---
# Random values, at least 32 characters (unlock and bypass secrets: at least 12).
# Production refuses to start with missing or short values when DATABASE_URL is set.
AUTH_SECRET=
INTERNAL_SIGNING_SECRET=
MEDIA_SIGNING_SECRET=
# Optional. Unset: no maintenance bypass (?bypass-secret= is ignored).
MAINTENANCE_BYPASS_SECRET=
# Optional. Set: /admin stays a 404 until unlocked by an emailed sign-in link (/s/...)
# or the break-glass form below. Unset: the hidden-login gate is off and /admin/login is public.
ADMIN_LOGIN_UNLOCK_SECRET=
# Recommended with the secret above. A path of your choosing (8-120 chars: letters, digits,
# _ - /, not under /api or the /admin auth pages), e.g. /k/3f9a7c2e. It serves a form that
# takes ADMIN_LOGIN_UNLOCK_SECRET in a password field (POST), so the secret never enters a URL.
# Once set, the old /admin?secret=<value> link stops working.
# ADMIN_UNLOCK_PATH=
# Optional. Days a sign-in link (/s/..., copied from Account) unlocks the login page: 1-90, default 14.
# ADMIN_SIGN_IN_LINK_DAYS=
# Vercel Cron sends this as a bearer token to /api/cron/*.
CRON_SECRET=

# --- Database backups (lib/backup, docs/backups.md) ---
# Off until the BACKUP_S3_* variables are set. A bucket used only for backups
# (S3-compatible: Neon Object Storage, R2, S3), and a key that can list, read,
# write and delete in it. Endpoint without the bucket name.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=db
# 32 bytes: openssl rand -base64 32. Keep a copy outside the bucket and the deployment.
BACKUP_ENCRYPTION_KEY=
# Older keys (comma-separated), to restore backups made before a rotation.
# BACKUP_ENCRYPTION_KEY_PREVIOUS=
# BACKUP_RETENTION_DAILY=14
# BACKUP_RETENTION_WEEKLY=8
# BACKUP_RETENTION_MONTHLY=6
# BACKUP_EXCLUDE_TABLES=
# Optional. Addresses (comma separated) that get a copy of account emails (invitations, new
# accounts, password resets) with every link left out. Toggle: Settings, Email routing.
# EMAIL_CC=
# Absolute links in emails. Falls back to the site URL in config/site.ts.
# SITE_URL=
# Site domains, primary first, then backups (comma separated, https only). Email and copied
# links use the first that answers /api/health, else the first that answers, else the first.
# Each domain is also a passkey relying party: a passkey works only on the domain where it
# was added, so add one on each. SITE_URL, when not in the list, is kept as the last backup.
# Unset: SITE_URL, then the site URL in config/site.ts.
# SITE_URLS=
# Extra origins allowed to POST to /admin and /api (comma separated), for previews.
# ADMIN_ALLOWED_ORIGINS=
# Optional. Developer masking for demos and screen shares (lib/auth/mask.ts). Off unless
# exactly "true"; while off, every role shows as it is and the mask toggles do not exist.
# ADMIN_PRESENTATION_MODE=
# Client IPs come from Vercel's own headers there. Anywhere else no header can be
# trusted, and every visitor shares one rate limit bucket, unless this says how
# many reverse proxies you run that append to X-Forwarded-For (1 for a single nginx).
# TRUSTED_PROXY_HOPS=

# --- Database: Postgres (Neon works well). Schema defaults to `public`; only ---
# --- set ?schema=<name> on the URL if you share one instance across projects. ---
DATABASE_URL=
# Optional direct (non-pooler) URL for the Prisma CLI.
# DIRECT_DATABASE_URL=

# --- Upstash Redis (rate limits and caches) ---
# Used when both are set and the URL is https, unless REDIS_ENABLED=false.
# Otherwise an in-memory store: fine for one server, not for serverless.
# REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Time zone whose calendar days visitor analytics are counted in (IANA, e.g. Asia/Colombo). Default UTC.
# ANALYTICS_TIME_ZONE=

# --- Media storage ---
# The single Cloudinary account (id "cloudinary", first in upload order).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# More accounts: up to 10 each of Cloudinary, S3 and R2, in numbered slots
# (slot 1 is tried first, after the account above). Each needs a stable id,
# never changed once it holds files, and a provider:
#   MEDIA_ACCOUNT_<n>_ID          lowercase letters, digits, dashes
#   MEDIA_ACCOUNT_<n>_PROVIDER    cloudinary | s3 | r2
#   MEDIA_ACCOUNT_<n>_CAP_GB      optional soft cap for new uploads
#   MEDIA_ACCOUNT_<n>_READ_ONLY   true: keep serving its files, upload nowhere
#   cloudinary: MEDIA_ACCOUNT_<n>_CLOUDINARY_URL (cloudinary://key:secret@cloud),
#       or _CLOUD_NAME, _API_KEY and _API_SECRET
#   s3: MEDIA_ACCOUNT_<n>_BUCKET, _REGION, _ACCESS_KEY_ID, _SECRET_ACCESS_KEY,
#       _PUBLIC_URL (https base files are served from), optional _ENDPOINT
#       (_ENDPOINT for S3-compatible services such as Neon Object Storage;
#       there _PUBLIC_URL is <endpoint>/<bucket> on a public_read bucket)
#   r2: MEDIA_ACCOUNT_<n>_ACCOUNT_ID, _BUCKET, _ACCESS_KEY_ID,
#       _SECRET_ACCESS_KEY, _PUBLIC_URL (r2.dev or a custom domain)
# Example: a second Cloudinary account, then a Neon Object Storage bucket.
# MEDIA_ACCOUNT_1_ID=cloudinary-2
# MEDIA_ACCOUNT_1_PROVIDER=cloudinary
# MEDIA_ACCOUNT_1_CLOUD_NAME=
# MEDIA_ACCOUNT_1_API_KEY=
# MEDIA_ACCOUNT_1_API_SECRET=
# MEDIA_ACCOUNT_2_ID=neon-s3
# MEDIA_ACCOUNT_2_PROVIDER=s3
# MEDIA_ACCOUNT_2_ENDPOINT=https://<branch>.storage.c-1.us-east-1.aws.neon.tech
# MEDIA_ACCOUNT_2_REGION=us-east-1
# MEDIA_ACCOUNT_2_BUCKET=app-media
# MEDIA_ACCOUNT_2_ACCESS_KEY_ID=
# MEDIA_ACCOUNT_2_SECRET_ACCESS_KEY=
# MEDIA_ACCOUNT_2_PUBLIC_URL=https://<branch>.storage.c-1.us-east-1.aws.neon.tech/app-media
# Seconds an account that answered "full" is skipped (default 21600).
MEDIA_FULL_TTL_S=

# --- Email ---
# auto (Resend, then Brevo SMTP), resend, brevo-smtp. `capture` is for tests only
# and production refuses it.
EMAIL_PROVIDER=auto
# Resend (primary)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
# Comma separated.
RESEND_RECIPIENT_EMAILS=
RESEND_CC_EMAILS=
RESEND_BCC_EMAILS=
# Brevo SMTP (fallback)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_SENDER_USER=
# Brevo transactional API key: diagnostics only (message events, senders).
EMAIL_BREVO_API_KEY=

# --- AI: blog generation, chatbot, images ---
# Free by default. Text runs as a chain: the first provider answers, and any
# failure (quota, timeout, bad key, retired model, bad output) hands the request
# to the next. Default order: gemini, openrouter, openrouter-2, nvidia, then the
# paid ones (openai, anthropic, deepseek, xai, perplexity, custom, vertex).
# Images: NVIDIA FLUX (free), then Gemini and Vertex image models.
# Paid providers only run when AI_ALLOW_PAID=true. A provider joins only when
# its key is set.
AI_ALLOW_PAID=false
# Blog AI assistant (draft, SEO, featured and inline images). Off by default;
# also needs at least one text provider key, and an image provider for images.
ENABLE_BLOG_AI=false
# Site chatbot. On by default; also needs a text provider key. false hides the
# widget and makes /api/chat return 503.
ENABLE_CHATBOT=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_ALLOW_PAID_MODELS=false
GEMINI_API_KEY=
# Also the free image provider (FLUX on ai.api.nvidia.com).
NVIDIA_API_KEY=
# More free tiers. Groq: free plan, no card (console.groq.com).
# OmniRoute: your self-hosted gateway (github.com/diegosouzapw/OmniRoute) pooling many
# providers' free tiers behind one endpoint. Setting the address makes it the first
# provider tried. https only (or http://localhost:20128). The key is a gateway key from
# its dashboard, not a Cheaper Inference ci_live_ key. Default model auto/best-free,
# which routes to free providers only.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
#OMNIROUTE_MODEL=
#BLOG_OMNIROUTE_MODEL=
#CHAT_OMNIROUTE_MODEL=
# Free only: a model override that is not a free route (ending -free or :free) is
# replaced by auto/best-free, even with AI_ALLOW_PAID. A paid route needs this AND
# AI_ALLOW_PAID, and then runs as a last resort.
#OMNIROUTE_ALLOW_PAID=false
GROQ_API_KEY=
#GROQ_MODEL=
#BLOG_GROQ_MODEL=openai/gpt-oss-120b
#CHAT_GROQ_MODEL=openai/gpt-oss-20b
# Mistral free (Experiment) plan: may train on prompts, so the chatbot skips it
# unless AI_PROVIDER_ORDER_CHAT lists "mistral". Opt out in the Mistral console.
MISTRAL_API_KEY=
#MISTRAL_MODEL=
#BLOG_MISTRAL_MODEL=mistral-medium-latest
#CHAT_MISTRAL_MODEL=
# Cloudflare Workers AI: 10,000 free neurons a day (then requests fail on the
# Free plan; on Workers Paid they are billed). Token scope: Workers AI read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
#CLOUDFLARE_AI_MODEL=
#BLOG_CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
#CHAT_CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b

# Provider order (optional). Comma-separated ids from the list above; only the
# listed providers run, in that order (paid ones still need AI_ALLOW_PAID).
# Per purpose first, then the global one. Settings > Integration health shows
# the resulting chain.
#AI_PROVIDER_ORDER=gemini,openrouter,nvidia,anthropic
#AI_PROVIDER_ORDER_BLOG=
#AI_PROVIDER_ORDER_CHAT=

# Paid text providers (AI_ALLOW_PAID=true). Model names change often; set the
# *_MODEL variables (BLOG_* and CHAT_* override per purpose).
OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-5-mini
#BLOG_OPENAI_MODEL=
#CHAT_OPENAI_MODEL=
ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#ANTHROPIC_MODEL=claude-sonnet-5-5
#BLOG_ANTHROPIC_MODEL=
#CHAT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=deepseek-chat
#BLOG_DEEPSEEK_MODEL=
#CHAT_DEEPSEEK_MODEL=
XAI_API_KEY=
#XAI_MODEL=grok-3-mini
#BLOG_XAI_MODEL=
#CHAT_XAI_MODEL=
PERPLEXITY_API_KEY=
#PERPLEXITY_MODEL=sonar
#BLOG_PERPLEXITY_MODEL=
#CHAT_PERPLEXITY_MODEL=
# One custom OpenAI-compatible endpoint (gateway, vLLM, Ollama, LiteLLM). Paid
# unless AI_CUSTOM_FREE=true; the key is optional for a local server.
#AI_CUSTOM_BASE_URL=http://localhost:11434/v1
#AI_CUSTOM_MODEL=llama3.2
#AI_CUSTOM_API_KEY=
#AI_CUSTOM_NAME=ollama
#AI_CUSTOM_FREE=false

# Models: every variable is optional. Each model resolves as
# purpose variable (BLOG_*, CHAT_*, IMAGE_*) > provider-wide variable
# (GEMINI_MODEL, ...) > built-in default (lib/ai/models.ts, shown here).
# Leave them empty unless you want a different model.
#GEMINI_MODEL=
#OPENROUTER_MODEL=
#NVIDIA_MODEL=
#VERTEX_MODEL=
#BLOG_GEMINI_MODEL=gemini-2.5-flash
#BLOG_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#BLOG_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
#BLOG_VERTEX_MODEL=gemini-2.5-flash
#CHAT_GEMINI_MODEL=gemini-3.1-flash-lite
#CHAT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#CHAT_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
#CHAT_VERTEX_MODEL=gemini-2.5-flash
#IMAGE_NVIDIA_MODEL=black-forest-labs/flux.1-dev
#IMAGE_GEMINI_MODEL=gemini-3.1-flash-image
#IMAGE_VERTEX_MODEL=gemini-3.1-flash-image
# Older name for IMAGE_VERTEX_MODEL, still read when that one is unset.
#IMAGEN_MODEL=

# --- Google Vertex service account (paid: Vertex text and images, AI_ALLOW_PAID=true) ---
GOOGLE_CLIENT_EMAIL=
# Keep the key on one line with literal \n sequences.
GOOGLE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=
# Optional; defaults to Google's token endpoint.
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# --- SEO: IndexNow ping (Bing + indexnow.org) ---
# The key doubles as the filename of its own proof file: public/<key>.txt
# must contain exactly the key, nothing else.
INDEXNOW_KEY=
# Bing Webmaster Tools API key, for diagnostics only (not used for the ping itself).
BING_API_KEY=
