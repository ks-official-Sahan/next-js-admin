# Copy to .env.local and fill in. .env.local is git-ignored (.env*.local).
# This file lists names only. Never put a real value here.
#
# The public site builds and runs with none of these set. The admin panel needs
# DATABASE_URL plus the secrets marked (admin).

# --- Owner account (seed). The password is temporary: change it on /admin/account. ---
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# --- Auth and signing (admin) ---
# Random values, at least 32 characters (unlock and bypass secrets: at least 12).
# Production refuses to start with missing or short values when DATABASE_URL is set.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AUTH_DEBUG=
INTERNAL_SIGNING_SECRET=
MEDIA_SIGNING_SECRET=
MAINTENANCE_BYPASS_SECRET=
ADMIN_LOGIN_UNLOCK_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/*.
CRON_SECRET=
# Absolute links in emails. Falls back to the site URL in config/site.ts.
# SITE_URL=
# Extra origins allowed to POST to /admin and /api (comma separated), for previews.
# ADMIN_ALLOWED_ORIGINS=
# Client IPs come from Vercel's own headers there. Anywhere else no header can be
# trusted, and every visitor shares one rate limit bucket, unless this says how
# many reverse proxies you run that append to X-Forwarded-For (1 for a single nginx).
# TRUSTED_PROXY_HOPS=

# --- Database: Postgres (Neon works well). Schema defaults to `public`; only ---
# --- set ?schema=<name> on the URL if you share one instance across projects. ---
DATABASE_URL=
# Optional direct (non-pooler) URL for the Prisma CLI.
# DIRECT_DATABASE_URL=

# --- Upstash Redis (rate limits and caches) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Email ---
# auto (Resend, then Brevo SMTP), resend, brevo-smtp. `capture` is for tests only
# and production refuses it.
EMAIL_PROVIDER=auto
# Resend (primary)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
# Comma separated.
RESEND_RECIPIENT_EMAILS=
RESEND_CC_EMAILS=
RESEND_BCC_EMAILS=
# Brevo SMTP (fallback)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_SENDER_USER=
# Brevo transactional API key: diagnostics only (message events, senders).
EMAIL_BREVO_API_KEY=

# --- AI: blog generation, chatbot, images ---
# Free by default. Text: Gemini, OpenRouter (:free models), NVIDIA, then Vertex.
# Images: NVIDIA FLUX (free), then Gemini and Vertex image models.
# Vertex (text and images) and Gemini images are billed, so they only run
# when AI_ALLOW_PAID=true.
AI_ALLOW_PAID=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_ALLOW_PAID_MODELS=false
GEMINI_API_KEY=
# Also the free image provider (FLUX on ai.api.nvidia.com).
NVIDIA_API_KEY=

# Models: every variable is optional. Each model resolves as
# purpose variable (BLOG_*, CHAT_*, IMAGE_*) > provider-wide variable
# (GEMINI_MODEL, ...) > built-in default (lib/ai/models.ts, shown here).
# Leave them empty unless you want a different model.
#GEMINI_MODEL=
#OPENROUTER_MODEL=
#NVIDIA_MODEL=
#VERTEX_MODEL=
#BLOG_GEMINI_MODEL=gemini-2.5-flash
#BLOG_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#BLOG_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
#BLOG_VERTEX_MODEL=gemini-2.5-flash
#CHAT_GEMINI_MODEL=gemini-3.1-flash-lite
#CHAT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#CHAT_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
#CHAT_VERTEX_MODEL=gemini-2.5-flash
#IMAGE_NVIDIA_MODEL=black-forest-labs/flux.1-dev
#IMAGE_GEMINI_MODEL=gemini-3.1-flash-image
# IMAGEN_MODEL is the older name for IMAGE_VERTEX_MODEL.
#IMAGE_VERTEX_MODEL=gemini-3.1-flash-image

# --- Google Vertex service account (paid: Vertex text and images, AI_ALLOW_PAID=true) ---
GOOGLE_CLIENT_EMAIL=
# Keep the key on one line with literal \n sequences.
GOOGLE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# --- SEO: IndexNow ping (Bing + indexnow.org) ---
# The key doubles as the filename of its own proof file: public/<key>.txt
# must contain exactly the key, nothing else.
INDEXNOW_KEY=
# Bing Webmaster Tools API key, for diagnostics only (not used for the ping itself).
BING_API_KEY=
