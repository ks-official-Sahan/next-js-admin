{
  "name": "admin-template",
  "description": "Admin panel starter: auth, RBAC, CMS, blog, media, leads and a chatbot, built on Next.js.",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "node --conditions=react-server --import tsx --test \"lib/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:admin": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db/admin-cli.ts",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db/seed.ts",
    "db:seed-content": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db/seed-content.ts",
    "db:seed-media": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db/seed-media.ts",
    "db:seed-blog": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db/seed-blog.ts",
    "db:drizzle:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@gsap/react": "^2.1.2",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sahan-sac/ai-core": "^0.3.1",
    "@sahan-sac/auth-kit": "^0.10.0",
    "@sahan-sac/blog-kit": "^0.3.1",
    "@sahan-sac/chat-kit": "^0.3.1",
    "@sahan-sac/email-kit": "^0.3.0",
    "@sahan-sac/media-kit": "^0.2.1",
    "@tabler/icons-react": "^3.20.0",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.107",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.445.0",
    "marked": "^18.0.14",
    "mini-svg-data-uri": "^1.4.4",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-wavify": "^1.11.1",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@prisma/adapter-pg": "^7.10.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "~19.2.7",
    "@types/react-dom": "~19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-simple-import-sort": "latest",
    "eslint-plugin-tailwindcss": "latest",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
