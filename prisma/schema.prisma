// Prisma schema for the admin platform and CMS.
//
// Database: Postgres, schema `public` by default (configurable via the
// `schema` query parameter on DATABASE_URL — see lib/db/url.ts). The CLI
// picks the schema from the connection string and the runtime picks it
// through the adapter option (see lib/db/prisma.ts). If you share one
// Postgres instance across several projects, give each its own schema and
// update lib/db/url.ts's ALLOWED_SCHEMAS accordingly.
//
// Change it through migrations: edit this file, `pnpm db:migration <name>`,
// review and commit prisma/migrations/*, then `pnpm db:migrate`. Never
// `db push`, `migrate dev` or `migrate reset` against a live database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaProvider {
  LOCAL
  CLOUDINARY
  S3
  R2
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum MfaPurpose {
  SIGN_IN
  ENABLE
  DISABLE
  STEP_UP
  PASSKEY_REGISTER
  PASSKEY_SIGN_IN
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
  EMAIL_CHANGE
}

// ─── Access: users, roles, sessions, tokens ───────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // Stored lowercase; the service layer normalises before every write.
  email              String    @unique
  // Read by the Better Auth engine; the app's own flows never set it.
  emailVerified      Boolean   @default(false)
  name               String?
  passwordHash       String
  role               String    @default("EDITOR")
  roleRecord         Role      @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  image              String?
  bio                String?   @db.Text
  mfaEnabled         Boolean   @default(false)
  // Authenticator-app (TOTP) secret, sealed with AES-256-GCM by the app; null until set up.
  totpSecretCipher   String?
  totpEnabledAt      DateTime?
  mustChangePassword Boolean   @default(false)
  // A DEVELOPER shown to everyone else as a SUPER_ADMIN (lib/auth/mask.ts). Presentation only.
  masked             Boolean   @default(false)
  passwordChangedAt  DateTime  @default(now())
  lastLoginAt        DateTime?
  disabledAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions          UserSession[]
  mfaChallenges     MfaChallenge[]
  recoveryCodes     MfaRecoveryCode[]
  passkeys          WebAuthnCredential[]
  posts             Post[]
  postRevisions     PostRevision[]
  auditLogs         AuditLog[]
  assignedInquiries Inquiry[]      @relation("InquiryAssignee")

  @@index([role])
  @@map("users")
}

// Roles are rows, so an admin adds one without a deploy (auth-kit 0.7).
// `rank` is the hierarchy: a lower rank manages higher ranks. DEVELOPER
// (rank 0) is also named in code and holds every permission there, so no
// stored row can lock the owner out. System roles cannot be renamed or deleted.
model Role {
  name        String   @id
  label       String
  description String?
  rank        Int
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  tokens      AuthToken[]

  @@index([rank])
  @@map("roles")
}

// A row means the permission is granted to the role. DEVELOPER always holds
// every permission in code, so it needs no rows.
model RolePermission {
  role        String
  roleRecord  Role     @relation(fields: [role], references: [name], onDelete: Cascade, onUpdate: Cascade)
  permission  String
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([role, permission])
  @@map("role_permissions")
}

// One row per signed-in browser. `id` is the `sid` claim in the JWT (next-auth
// engine); `token` is the session cookie value (Better Auth engine). This table
// is authoritative for revocation; Redis only caches the state for 30 seconds.
model UserSession {
  id           String    @id @default(cuid())
  token        String?   @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?   @db.Text
  browser      String?
  os           String?
  device       String?
  mfaVerified  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  // Known-IPs list on the allowlist screen, newest first.
  @@index([lastSeenAt])
  @@map("user_sessions")
}

// Invite and password-reset links. Only the SHA-256 of the token is stored.
model AuthToken {
  id          String       @id @default(cuid())
  purpose     TokenPurpose
  email       String
  userId      String?
  // Role granted on acceptance (invites only).
  role        String?
  roleRecord  Role?        @relation(fields: [role], references: [name], onDelete: SetNull, onUpdate: Cascade)
  tokenHash   String       @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  // Pending invites: open tokens of one purpose that have not expired.
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}

// Emailed one-time codes for sign-in, enabling and disabling MFA.
// `verifiedAt` is set when the right code is entered. `consumedAt` is set
// atomically when the sign-in (or the enable/disable action) uses the
// verified challenge, so one challenge can never open two sessions.
model MfaChallenge {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    MfaPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, expiresAt])
  // The cleanup cron deletes by expiry across all users.
  @@index([expiresAt])
  @@map("mfa_challenges")
}

// Single-use recovery codes for a user with an authenticator app or passkey.
// Only a hash is stored; `usedAt` is set atomically when one is spent.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// Passkeys (WebAuthn credentials). `id` is the credential id the
// authenticator returns (base64url); `publicKey` is its COSE key, base64url.
model WebAuthnCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  publicKey  String
  // The authenticator's signature counter: an unsigned 32-bit value.
  counter    BigInt    @default(0)
  transports String[]  @default([])
  deviceType String
  backedUp   Boolean   @default(false)
  name       String    @default("Passkey")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshots, so the trail survives deleting the user or changing their role.
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  // Matches the (createdAt, id) keyset cursor in lib/admin/audit-filters.ts;
  // still serves anything that only filters or sorts by createdAt.
  @@index([createdAt, id])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Operational switches (maintenance, feature flags, allowlist). Editable by
// DEVELOPER only. Everything a visitor reads lives in ContentBlock instead.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("settings")
}

// ─── CMS: versioned page sections ─────────────────────────────────────────────
// At most one DRAFT and one PUBLISHED row per (pageSlug, sectionSlug).

model ContentBlock {
  id            String        @id @default(cuid())
  pageSlug      String
  sectionSlug   String
  version       Int
  data          Json
  status        ContentStatus @default(DRAFT)
  note          String?
  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([pageSlug, sectionSlug, version])
  @@index([pageSlug, sectionSlug, status])
  @@index([pageSlug, status])
  @@map("content_blocks")
}

// ─── Updates (blog) ───────────────────────────────────────────────────────────

model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  excerpt        String?     @db.Text
  // Editor HTML as saved by TipTap.
  content        String      @db.Text
  // Sanitized copy that the public site renders.
  contentHtml    String      @db.Text
  // Plain text for search and read time.
  contentText    String      @db.Text
  // The first EXCERPT_CHARS of contentText, written on save, so list reads
  // can show an excerpt without loading the whole text (lib/blog/queries.ts).
  autoExcerpt    String      @default("")
  topic          String
  tags           String[]    @default([])
  status         PostStatus  @default(DRAFT)
  publishAt      DateTime?
  publishedAt    DateTime?
  coverMediaId   String?
  coverMedia     MediaAsset? @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverAlt       String?
  seoTitle       String?
  seoDescription String?     @db.Text
  canonicalUrl   String?
  readMinutes    Int         @default(1)
  generatedByAI  Boolean     @default(false)
  // Published but kept out of search engines: robots noindex, and left out of
  // the sitemap, RSS and llms.txt.
  noindex        Boolean     @default(false)
  // Optional so deleting an author never fails on a foreign key.
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  revisions     PostRevision[]
  slugRedirects PostSlugRedirect[]

  // Keyset pages order by (publishedAt | publishAt, id); id breaks ties.
  @@index([status, publishedAt, id])
  @@index([status, publishAt, id])
  @@index([status, noindex, publishedAt, id])
  @@index([status, noindex, publishAt, id])
  @@index([coverMediaId])
  @@index([authorId])
  // Admin list default sort, and the distinct-topic picker.
  @@index([updatedAt])
  @@index([topic])
  @@map("posts")
}

// A snapshot of a post's editable fields taken just before an edit replaced
// them, so any earlier version can be viewed and restored. `data` is JSON
// (see lib/blog/revisions.ts) so adding an editable field never needs a
// migration here. Pruned to the newest few per post by the audit-prune cron.
model PostRevision {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Copied out of `data` so the history list never loads full snapshots.
  title       String
  data        Json
  // What replaced this version: "update", "restore" or "ai".
  reason      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
  @@index([createdById])
  @@map("post_revisions")
}

// An old slug of a post, kept after a rename so /updates/<old> answers with a
// permanent redirect to the post's current slug instead of a 404. A new post
// or rename that takes the slug removes the row (lib/actions/blog.ts).
model PostSlugRedirect {
  slug      String   @id
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("post_slug_redirects")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String        @id @default(cuid())
  provider    MediaProvider @default(CLOUDINARY)
  // The storage account holding the file (MEDIA_ACCOUNT_<n>_ID, or
  // "cloudinary" for the CLOUDINARY_* account). Serving and deleting go to
  // this account only. Ignored for LOCAL assets.
  accountId   String        @default("cloudinary")
  kind        MediaKind     @default(IMAGE)
  // Absolute delivery URL (Cloudinary, or the bucket's public URL), or a
  // /works/... path for LOCAL assets.
  url         String
  // Cloudinary public_id, or the object key in an S3/R2 bucket.
  publicId    String?
  format      String
  width       Int?
  height      Int?
  sizeBytes   Int
  title       String?
  alt         String?
  tags        String[]      @default([])
  folder      String        @default("uncategorized")
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  usages     MediaUsage[]
  postCovers Post[]       @relation("PostCover")

  @@unique([provider, accountId, publicId])
  @@index([accountId])
  @@index([folder, createdAt])
  // The library's keyset order (createdAt desc, id desc).
  @@index([createdAt, id])
  @@map("media_assets")
}

// Where an asset is used. Maintained by the services on save and read by the
// "in use" warning before a delete.
model MediaUsage {
  id         String     @id @default(cuid())
  mediaId    String
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  field      String
  createdAt  DateTime   @default(now())

  @@unique([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("media_usages")
}

// ─── Contact and leads ────────────────────────────────────────────────────────

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  topic           String?
  message         String        @db.Text
  status          InquiryStatus @default(NEW)
  notes           String?       @db.Text
  assigneeId      String?
  assignee        User?         @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // "contact-form" or "chatbot".
  source          String        @default("contact-form")
  // HMAC of the visitor IP, never the address itself.
  ipHash          String?
  userAgent       String?       @db.Text
  pagePath        String?
  spamScore       Int           @default(0)
  // PENDING, SENT or FAILED.
  emailStatus     String        @default("PENDING")
  autoReplyStatus String        @default("PENDING")
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events       InquiryEmailEvent[]
  chatSessions ChatSession[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("inquiries")
}

model InquiryEmailEvent {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  // "notify" or "auto-reply".
  kind      String
  provider  String
  ok        Boolean
  messageId String?
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_email_events")
}

// ─── Chatbot ──────────────────────────────────────────────────────────────────

model ChatSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  ipHash        String?
  userAgent     String?  @db.Text
  pagePath      String?
  inquiryId     String?
  inquiry       Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  messagesCount Int      @default(0)
  capturedLead  Boolean  @default(false)
  leadName      String?
  leadContact   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@index([createdAt])
  @@index([inquiryId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      String
  content   String      @db.Text
  tokens    Int?
  latencyMs Int?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ChatTrainingEntry {
  id          String   @id @default(cuid())
  category    String   @default("FAQ")
  question    String   @db.Text
  answer      String   @db.Text
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@map("chat_training_entries")
}

// ─── Trash ────────────────────────────────────────────────────────────────────
// A deleted post, media asset or collection row, kept as a JSON snapshot for
// 30 days so it can be restored with its id. Deleting writes this row and
// removes the original in one transaction, so nothing else ever filters on a
// deleted flag. The housekeeping cron purges expired rows (and only then
// deletes a media file from Cloudinary). Design: lib/trash/*.
model TrashItem {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  // Shown in the trash list without parsing `data`.
  label       String
  data        Json
  deletedById String?
  deletedAt   DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_items")
}

// ─── Outgoing webhooks ────────────────────────────────────────────────────────
// Signed POSTs to external consumers when public content changes. The signing
// secret is shown once and stored encrypted (lib/webhooks/secret.ts).
model WebhookEndpoint {
  id           String   @id @default(cuid())
  url          String
  description  String   @default("")
  secretCipher String
  // Event names this endpoint receives; empty means every event.
  events       String[] @default([])
  active       Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  // Sent as Idempotency-Key, so a consumer can drop a retried duplicate.
  idempotencyKey String                @unique
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}
