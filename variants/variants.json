{
  "$comment": "Read by create-admin (cli/lib/variants.mjs). The repo itself is next-auth + Prisma with the Drizzle implementation alongside. For each choice: copy `overlay` over the project, then delete `remove`, then edit package.json (a null value deletes the key) and .env.example. The Better Auth overlay is lib/auth/engine.ts and session-cookie.ts with the other engine's import (`npx auth-kit engine better-auth --write` makes the same change).",
  "auth": {
    "next-auth": {},
    "better-auth": {
      "overlay": "variants/auth/better-auth",
      "dependencies": {
        "better-auth": "^1.7.6",
        "next-auth": null
      },
      "env": {
        "remove": [
          "AUTH_TRUST_HOST",
          "AUTH_DEBUG"
        ]
      }
    }
  },
  "orm": {
    "prisma": {
      "remove": [
        "lib/data/drizzle",
        "lib/db/drizzle.ts",
        "lib/db/schema.ts",
        "drizzle.config.ts",
        "lib/data/schema-parity.test.ts",
        "lib/data/test-support/drizzle-ddl.ts",
        "drizzle",
        "scripts/drizzle-migration.ts"
      ],
      "dependencies": {
        "drizzle-orm": null
      },
      "devDependencies": {
        "drizzle-kit": null
      },
      "scripts": {
        "db:drizzle:migrate": null,
        "db:drizzle:migration": null
      }
    },
    "drizzle": {
      "overlay": "variants/orm/drizzle",
      "remove": [
        "lib/data/prisma",
        "lib/db/prisma.ts",
        "prisma",
        "prisma.config.ts",
        "lib/data/schema-parity.test.ts",
        "lib/data/test-support/prisma-ddl.ts",
        "scripts/db-migration.ts"
      ],
      "dependencies": {
        "@prisma/adapter-neon": null,
        "@prisma/client": null
      },
      "devDependencies": {
        "@prisma/adapter-pg": null,
        "@electric-sql/pglite-socket": null,
        "prisma": null
      },
      "scripts": {
        "postinstall": null,
        "db:generate": null,
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:status": null,
        "db:migration": "node --import tsx scripts/drizzle-migration.ts",
        "db:drizzle:migrate": null,
        "db:drizzle:migration": null
      }
    }
  }
}
