{
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/blog-publish",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/session-cleanup",
      "schedule": "5 2 * * *"
    },
    {
